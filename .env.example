# Stonkbag local env. Never commit this file. Production values go in Vercel → Project → Settings → Environment Variables.

# --- Core ---
DATABASE_URL=postgres://USER@localhost:5432/stonkbag
CRON_SECRET=
# 1Click API key (NEAR Intents partner key)
ONECLICK_JWT=

# --- Needed now (Day 1) ---
# twelvedata.com → Sign up → Dashboard → API Keys
TWELVEDATA_API_KEY=
# cloud.reown.com → Create project → Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Needed Day 2 (real-money test) ---
# A NEAR account you create for paying gas, funded with ~5 NEAR, e.g. stonkbag-relayer.near
RELAYER_ACCOUNT_ID=
# That account's private key, format ed25519:...
RELAYER_PRIVATE_KEY=
# Any NEAR account you control. Platform fees land in its NEAR Intents balance.
PLATFORM_FEE_ACCOUNT=

# --- Needed Day 4 ---
# Your wallets that can open /admin, comma-separated (NEAR account and/or EVM address)
ADMIN_WALLETS=

# --- Optional ---
# finnhub.io → Dashboard → API key (backup stock prices)
FINNHUB_API_KEY=
# Defaults to https://rpc.mainnet.fastnear.com
NEAR_RPC_URL=
